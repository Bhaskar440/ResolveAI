# ============================================================
#  ResolveAI — environment template
#  Copy to .env.local and fill in. NEVER commit .env.local.
#    PowerShell:  Copy-Item .env.example .env.local
#  Only .env.example is committed; .env* is git-ignored.
# ============================================================

# ---------- App ----------
APP_ENV=local                       # local | demo | staging | production
APP_NAME=ResolveAI
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
LOG_FORMAT=pretty
TIMEZONE=UTC
CORS_ORIGINS=http://localhost:3000

# Generate secrets with:
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
CREDENTIAL_KEK=
PII_HASH_PEPPER=
PLAN_SIGNING_KEY=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@localhost:55433/resolveai
DB_ECHO=false
PGVECTOR_ENABLED=false

# ---------- PayPal ----------
# replay = fixtures only (no credentials needed) | sandbox = real sandbox API
PAYPAL_MODE=replay
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_VERIFY=true
PAYPAL_WEBHOOK_MAX_SKEW_SECONDS=300
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_MAX_RETRIES=2
PAYPAL_RECONCILE_INTERVAL_SECONDS=300
PAYPAL_MERCHANT_ID=
PAYPAL_SELLER_EMAIL=
ALLOW_LIVE_PAYPAL=false

# ---------- LLM / agents ----------
# google | openai | anthropic | openrouter
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1600
LLM_TIMEOUT_SECONDS=60
AGENT_MAX_NEGOTIATION_ROUNDS=3
AGENT_MAX_TOOL_CALLS=40
AGENT_MAX_WALL_CLOCK_SECONDS=120
AGENT_MAX_TOKENS_PER_RUN=250000

# ---------- Autonomy (business policy) ----------
AUTONOMY_ENABLED=true
AUTO_RESOLVE_CAP_USD=50
AUTO_OFFER_CAP_USD=100
APPROVAL_EXPIRY_MINUTES=120
AUTO_APPROVE_CONFIDENCE=0.80
ESCALATE_CONFIDENCE=0.55
FRAUD_REASONS_REQUIRE_APPROVAL=UNAUTHORISED,DUPLICATE_TRANSACTION
POLICY_RULESET_VERSION=2026.11.1

# ---------- Evidence storage ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./var/evidence
MAX_EVIDENCE_MB=10
SIGNED_URL_TTL_SECONDS=300

# ---------- Frontend (public values only) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=ResolveAI
NEXT_PUBLIC_DEMO_MODE=true

# ---------- Optional / later ----------
# GITHUB_TOKEN=            # optional: fine-grained PAT, contents:write only
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
